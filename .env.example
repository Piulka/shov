# Local development creates a browser-bound test account.
# Set APP_MODE=telegram with BOT_TOKEN for authenticated Telegram accounts.
APP_MODE=local
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=data/shov.sqlite
# Compose uses /data/shov.sqlite inside its persistent data volume.
BOT_TOKEN=
# Required public HTTPS origin in telegram mode.
APP_ORIGIN=
# Only the IPs/CIDRs of your reverse proxy. Empty means no trusted proxy.
TRUSTED_PROXY=
# Telegram beta: allowlist (invited IDs) or open (any verified Telegram account).
BETA_ACCESS=open
BETA_TELEGRAM_IDS=
# Applied to sign-in AND existing sessions after server restart.
BLOCKED_TELEGRAM_IDS=
# Defaults to info in Telegram and silent locally; never logs auth bodies/cookies.
LOG_LEVEL=info
# Docker Compose / Caddy certificate contact and release image tag.
ACME_EMAIL=
SHOV_IMAGE_TAG=beta
